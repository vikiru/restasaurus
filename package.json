{
	"name": "restasaurus",
	"version": "1.0.1",
	"description": "A dinosaur REST API built using Express, MongoDB and Mongoose with comprehensive data for almost 1200 dinosaurs.",
	"private": true,
	"author": "Visakan Kirubakaran",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/vikiru/restasaurus.git"
	},
	"keywords": [
		"RESTasaurus",
		"REST",
		"API",
		"MongoDB",
		"Mongoose",
		"Express",
		"Dinosaurs"
	],
	"main": "./app/app.js",
	"scripts": {
		"start": "node .",
		"dev": "cross-env NODE_ENV=development nodemon ./app/**/*.js",
		"test": "cross-env NODE_ENV=test nyc --reporter=json-summary --reporter=html --reporter=text mocha test/test.js --exit && open-cli ./coverage/index.html",
		"lint": "biome lint",
		"format": "biome check --write",
		"retrieveData": "node ./app/scripts/constructDinoNames.js && node ./app/scripts/retrieveData.js",
		"postData": "node ./app/scripts/postData.js",
		"make-badges": "istanbul-badges-readme",
		"postinstall": "lefthook install",
		"unused": "knip"
	},
	"dependencies": {
		"@mongodb-js/zstd": "^7.0.0",
		"body-parser": "^1.20.5",
		"compression": "^1.8.1",
		"cors": "^2.8.6",
		"dotenv": "^16.6.1",
		"express": "^4.22.1",
		"express-rate-limit": "^7.5.1",
		"express-validator": "^7.3.2",
		"helmet": "^7.2.0",
		"mongodb": "^7.2.0",
		"mongoose": "^8.23.1",
		"mongoose-autopopulate": "^1.2.1",
		"mongoose-hidden": "^1.9.1",
		"mongoose-sequence": "^6.0.1",
		"morgan": "^1.10.1",
		"node-html-parser": "^6.1.13",
		"redis": "^4.7.1",
		"serve-favicon": "^2.5.1",
		"snappy": "^7.3.3",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@semantic-release/git": "^10.0.1",
		"chai": "^6.2.2",
		"chai-http": "^5.1.2",
		"cross-env": "^5.2.1",
		"esm": "^3.2.25",
		"husky": "^9.1.7",
		"istanbul-badges-readme": "^1.9.0",
		"knip": "^5.88.1",
		"lefthook": "^2.1.6",
		"mocha": "^11.7.5",
		"nodemon": "^3.1.14",
		"nyc": "^15.1.0",
		"open-cli": "^8.0.0",
		"proxyquire": "^2.1.3",
		"semantic-release": "^25.0.3",
		"sinon": "^21.1.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.5"
	},
	"ignorePatterns": [
		"./node_modules/**",
		"./.github/**"
	],
	"engines": {
		"node": ">=16.9"
	}
}